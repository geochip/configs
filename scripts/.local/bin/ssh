#!/bin/sh

set -euo pipefail

case "$*" in
	'gyle task show --help' | 'gyle task show '*[0-9]* | \
	'gyle task run --help' | 'gyle task run '*[0-9]* | \
	'gyle task commit --help' | 'gyle task commit '*[0-9]* | \
	'gyle task test --help' | 'gyle task test '*[0-9]* | \
	'gyle task add --help' | 'gyle task add '*[0-9]*' repo'* | 'gyle task add '*[0-9]*' copy'*)
		/usr/bin/ssh "$@"
		;;
	'gyle task show'* | 'gyle task run'* | 'gyle task commit'* | 'gyle task test'* | 'gyle task add'*)
		echo "nope, specify task id"
		;;
	*)
		/usr/bin/ssh "$@"
		;;
esac
